{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsc-audit:schema:audit-return:v0.1",
  "title": "BSC non-admissive audit-return inspection envelope",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "idList": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "activity": {
      "enum": [
        "model_reasoning",
        "web_research",
        "independent_source_check",
        "chatgpt_data_analysis",
        "bsc_python_checker",
        "external_proof_tool",
        "empirical_test",
        "proposed_computation"
      ]
    },
    "activityList": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/activity"}
    },
    "nullableText": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"}
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "research_verdict", "depends_on", "source_ids", "evidence_ids", "fatal_gate_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/text"},
        "research_verdict": {
          "enum": ["proven", "strongly_supported", "plausible_but_unresolved", "refuted", "ill_posed", "outside_current_knowledge"]
        },
        "depends_on": {"$ref": "#/$defs/idList"},
        "source_ids": {"$ref": "#/$defs/idList"},
        "evidence_ids": {"$ref": "#/$defs/idList"},
        "fatal_gate_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "coverage_state", "access_mode", "inspected_scope", "omissions", "artifact_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"},
        "kind": {"enum": ["document", "code", "data", "citation", "web_page", "other"]},
        "coverage_state": {"enum": ["fully_inspected", "partially_inspected", "unreadable", "missing", "possibly_truncated"]},
        "access_mode": {"enum": ["attachment", "paste", "web", "citation_only", "unavailable"]},
        "inspected_scope": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"}
        },
        "omissions": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"}
        },
        "artifact_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "filename", "role", "media_type", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "filename": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+(?![\\s\\S])"},
        "role": {"enum": ["request", "report", "source", "evidence", "receipt", "execution_output", "other"]},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "result", "claim_ids", "gate_ids", "artifact_ids", "execution_activities", "receipt_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["argument", "calculation", "counterexample", "citation", "execution_output", "formal_certificate", "empirical_result", "other"]},
        "status": {"enum": ["verified", "unverified", "missing"]},
        "result": {"enum": ["pass", "fail", "inconclusive"]},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "gate_ids": {"$ref": "#/$defs/idList"},
        "artifact_ids": {"$ref": "#/$defs/idList"},
        "execution_activities": {"$ref": "#/$defs/activityList"},
        "receipt_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "fatalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "evidence_ids", "obligation_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "state": {"enum": ["pass", "fail", "unrun", "conflict"]},
        "evidence_ids": {"$ref": "#/$defs/idList"},
        "obligation_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity", "status", "tool", "version", "input_artifact_ids", "output_artifact_ids", "receipt_ids", "notes"],
      "properties": {
        "activity": {"$ref": "#/$defs/activity"},
        "status": {"enum": ["ran", "not_run", "reported_but_unverified", "not_applicable", "file_read_only"]},
        "tool": {"$ref": "#/$defs/nullableText"},
        "version": {"$ref": "#/$defs/nullableText"},
        "input_artifact_ids": {"$ref": "#/$defs/idList"},
        "output_artifact_ids": {"$ref": "#/$defs/idList"},
        "receipt_ids": {"$ref": "#/$defs/idList"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "kind", "artifact_id", "claim_ids", "gate_ids", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "authority": {"enum": ["execution_record", "non_admissive_provenance"]},
        "kind": {"enum": ["citation_access", "chatgpt_tool_output", "bsc_cli_output", "adapter_receipt", "external_tool_transcript", "empirical_record", "other"]},
        "artifact_id": {"$ref": "#/$defs/id"},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "gate_ids": {"$ref": "#/$defs/idList"},
        "status": {"enum": ["verified", "unverified", "missing"]}
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "claim_ids", "gate_ids", "evidence_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"$ref": "#/$defs/text"},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "gate_ids": {"$ref": "#/$defs/idList"},
        "evidence_ids": {"$ref": "#/$defs/idList"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["return_version", "authority", "draft", "protocol", "bindings", "audit_depth", "primary_claim_id", "claims", "summary_projection", "sources", "artifacts", "evidence", "fatal_gates", "execution", "receipts", "unresolved_obligations"],
  "properties": {
    "return_version": {"const": "0.1.0"},
    "authority": {"const": "non_admissive_return_inspection"},
    "draft": {"const": true},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_artifact_id", "report_artifact_id"],
      "properties": {
        "request_artifact_id": {"$ref": "#/$defs/id"},
        "report_artifact_id": {"$ref": "#/$defs/id"}
      }
    },
    "audit_depth": {"enum": ["quick", "standard", "adversarial", "formal-mathematical"]},
    "primary_claim_id": {"$ref": "#/$defs/id"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/claim"}
    },
    "summary_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_claim_id", "research_verdict", "admission", "deployment_status", "fatal_gate_ids", "unresolved_obligation_ids"],
      "properties": {
        "primary_claim_id": {"$ref": "#/$defs/id"},
        "research_verdict": {"enum": ["proven", "strongly_supported", "plausible_but_unresolved", "refuted", "ill_posed", "outside_current_knowledge"]},
        "admission": {"enum": ["pass", "fail", "unrun", "conflict"]},
        "deployment_status": {"enum": ["research_only", "sandboxed", "candidate", "admitted", "retired"]},
        "fatal_gate_ids": {"$ref": "#/$defs/idList"},
        "unresolved_obligation_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/source"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "evidence": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "fatal_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/fatalGate"}
    },
    "execution": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/execution"}
    },
    "receipts": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/receipt"}
    },
    "unresolved_obligations": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/obligation"}
    }
  }
}
