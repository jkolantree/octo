{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jkolantree/bsc-audit-engine/schemas/atomic-modulus-v0.3.schema.json",
  "title": "BSC finite atomic-modulus record",
  "$defs": {
    "nonnegativeRational": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "string", "pattern": "^(0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$"}]},
    "positiveRational": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*(?:/[1-9][0-9]*)?$"}]}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["modulus", "compacts"],
  "properties": {
    "modulus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constant", "exponent", "proof_id"],
      "properties": {
        "constant": {"$ref": "#/$defs/nonnegativeRational"},
        "exponent": {"type": "integer", "minimum": 1, "maximum": 64},
        "proof_id": {"type": "string", "minLength": 1}
      }
    },
    "compacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "distance_from_origin", "samples"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "distance_from_origin": {"$ref": "#/$defs/positiveRational"},
          "samples": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["epsilon", "mass_upper"],
              "properties": {"epsilon": {"$ref": "#/$defs/positiveRational"}, "mass_upper": {"$ref": "#/$defs/nonnegativeRational"}}
            }
          }
        }
      }
    }
  }
}
