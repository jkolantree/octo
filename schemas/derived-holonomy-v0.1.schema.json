{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jkolantree/octo/v0.3.0-alpha.3/schemas/derived-holonomy-v0.1.schema.json",
  "title": "BSC exact derived-holonomy record",
  "$defs": {
    "scalar": {"oneOf": [{"type": "integer"}, {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}]},
    "matrix": {"type": "array", "maxItems": 128, "items": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/scalar"}}},
    "basisRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "meaning", "sha256"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 256},
        "meaning": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "complex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "differentials", "basis"],
      "properties": {
        "groups": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"}, "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 128}},
        "differentials": {"type": "object", "maxProperties": 128, "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"}, "additionalProperties": {"$ref": "#/$defs/matrix"}},
        "basis": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"}, "additionalProperties": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/basisRecord"}}}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "maps"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "maps": {"type": "object", "maxProperties": 128, "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"}, "additionalProperties": {"$ref": "#/$defs/matrix"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_path", "right_path", "required_equivalence"],
      "properties": {
        "left_path": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
        "right_path": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1}},
        "required_equivalence": {"enum": ["strict", "derived", "observed_derived"]},
        "observation_projection": {"type": "string", "minLength": 1}
      },
      "if": {"type": "object", "required": ["required_equivalence"], "properties": {"required_equivalence": {"const": "observed_derived"}}},
      "then": {"required": ["observation_projection"]}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["holonomy_version", "field", "contexts", "transports", "relations"],
  "properties": {
    "holonomy_version": {"const": "0.1.0"},
    "field": {"const": "Q"},
    "contexts": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"pattern": "^.{1,256}$"}, "additionalProperties": {"$ref": "#/$defs/complex"}},
    "transports": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"pattern": "^.{1,256}$"}, "additionalProperties": {"$ref": "#/$defs/transport"}},
    "relations": {"type": "object", "minProperties": 1, "maxProperties": 128, "propertyNames": {"pattern": "^.{1,256}$"}, "additionalProperties": {"$ref": "#/$defs/relation"}}
  }
}
