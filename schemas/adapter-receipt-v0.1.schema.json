{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bsc-audit:schema:adapter-receipt:v0.1",
  "title": "BSC proof-carrying adapter receipt preview",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "authority", "receipt_id", "claim_id", "adapter", "job", "subject", "environment", "execution", "certificate", "verification", "result_token", "outcome"],
  "properties": {
    "receipt_version": {"const": "0.1.0"},
    "authority": {"const": "non_admissive_preview"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "claim_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "executable_sha256"],
      "properties": {
        "kind": {"enum": ["lean4", "smtlib2", "interval"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "executable_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "job": {"$ref": "#/$defs/artifactRef"},
    "subject": {"$ref": "#/$defs/artifactRef"},
    "environment": {"$ref": "#/$defs/artifactRef"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "exit_code", "transcript"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "transcript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdout", "stderr"],
          "properties": {
            "stdout": {"$ref": "#/$defs/artifactRef"},
            "stderr": {"$ref": "#/$defs/artifactRef"}
          }
        }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "format"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["lean4-kernel-check", "alethe", "lfsc", "drat", "exact-interval-replay"]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker", "checker_relation", "replay_verified", "assumption_policy"],
      "properties": {
        "checker": {"$ref": "#/$defs/tool"},
        "checker_relation": {"enum": ["same_kernel", "independent_checker"]},
        "replay_verified": {"type": "boolean"},
        "assumption_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "observed"],
          "properties": {
            "allowed": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
            "observed": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
          }
        }
      }
    },
    "result_token": {"enum": ["accepted", "rejected", "unsat", "sat", "enclosed", "violated", "unknown", "error"]},
    "outcome": {"enum": ["pass", "fail", "inconclusive", "error"]}
  }
}
